# Build-time configuration (committed — contains NO secrets).
#
# Emit the webpack runtime as a separate file instead of an inline <script> in
# index.html. This lets the Content-Security-Policy use a strict `script-src
# 'self'` (no 'unsafe-inline') without blocking the app from booting.
INLINE_RUNTIME_CHUNK=false

# The API base URL (REACT_APP_API_BASE) and the sim access code
# (REACT_APP_SIM_ACCESS_CODE, default "SPARTA") are configured per-environment
# in the Vercel dashboard, not here.
